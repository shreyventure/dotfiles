# Machine-specific settings (e.g. whatever Codespaces had in ~/.gitconfig before
# install.sh ran). Included first so everything below overrides it.
# Silently ignored if the file doesn't exist.
[include]
    path = ~/.gitconfig.local

# --- Global Default (For all your public repos) ---
[user]
    name = Shreyas Shrawage
    email = shreyas.shrawage2000@gmail.com

# --- Work email for any repo in the neon-xyz GitHub org ---
# Matched by remote URL, so it works wherever the repo is cloned
# (locally or in Codespaces at /workspaces/<repo-name>). Needs git >= 2.36.
[includeIf "hasconfig:remote.*.url:https://github.com/neon-xyz/**"]
    path = ~/.gitconfig-private
[includeIf "hasconfig:remote.*.url:git@github.com:neon-xyz/**"]
    path = ~/.gitconfig-private
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/neon-xyz/**"]
    path = ~/.gitconfig-private
